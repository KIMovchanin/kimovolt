# Production (Oracle Cloud ARM64 behind local reverse proxy)
BIND_ADDR=127.0.0.1
PORT=8080
DB_PATH=/opt/kimovolt-lab/data/kimovolt.db
STATIC_DIR=/opt/kimovolt-lab/frontend/dist
COOKIE_SECURE=true
PUBLIC_ORIGIN=https://kimovolt.com
KIMOVOLT_DOMAIN=kimovolt.com

# For local HTTP development set:
# BIND_ADDR=127.0.0.1
# DB_PATH=./data/kimovolt.db
# STATIC_DIR=./frontend/dist
# COOKIE_SECURE=false
# PUBLIC_ORIGIN=http://localhost:8080
